{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "type": "shell",
      "command": "gcc",
      "args": [
        "main.c",
        "-ID:/libs/SDL2-devel-2.32.8-mingw/SDL2-2.32.8/i686-w64-mingw32/include",     // Include SDL2 headers
        "-LD:/libs/SDL2-devel-2.32.8-mingw/SDL2-2.32.8/i686-w64-mingw32/lib",         // Link SDL2 lib
        "-lmingw32", "-lSDL2main", "-lSDL2", // Link libraries
        "-o", "build/main.exe"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}